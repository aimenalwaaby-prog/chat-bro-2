# Server-only secrets. Never copy these values into EXPO_PUBLIC_* variables or the APK.
DATABASE_URL=
JWT_SECRET=
KEY_VAULT_SECRET=
CORS_ALLOWED_ORIGINS=
ALLOWED_ORIGINS=
EXPO_PUBLIC_API_BASE_URL=
PUBLIC_API_BASE_URL=

# Subscription system is fully installed but intentionally disabled for the trial launch.
SUBSCRIPTIONS_ENABLED=false
PLUS_PRICE_CENTS=500
PLUS_CURRENCY=USD

# JSON object of high protective limits. Omit entries to use generous defaults.
# Example: {"chat":{"hour":500,"day":5000},"image":{"day":300}}
USAGE_LIMITS_JSON={}

# Optional arrays of server-side keys for safe round-robin rotation.
# Example: {"openrouter":["key-a","key-b"],"gemini":["key-a","key-b"]}
PROVIDER_API_KEYS_JSON={}

# Existing provider settings remain server-side.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
MODEL_GATEWAYS_JSON={}
OLLAMA_BASE_URL=

# Additional OpenAI-compatible chat providers; these stay on the server, never EXPO_PUBLIC_ or in the APK.
HF_TOKEN=
MISTRAL_API_KEY=
DEEPINFRA_API_KEY=
NVIDIA_API_KEY=
FIREWORKS_API_KEY=
GITHUB_TOKEN=
VOICE_ALLOWED_HOSTS=
OLLAMA_BASE_URL=http://127.0.0.1:11434
HF_TOKEN=
HF_INFERENCE_TOKEN=
REPLICATE_API_TOKEN=
TOGETHER_API_KEY=
GROQ_API_KEY=
KAGGLE_USERNAME=
KAGGLE_KEY=

# Image providers. Replicate/Fal are server-side image-generation providers, not general chat model catalogs.
REPLICATE_API_TOKEN=
FAL_KEY=
